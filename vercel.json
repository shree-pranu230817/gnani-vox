{
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "templates/**",
        "static/**",
        "api/templates/**",
        "api/static/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!static/|css/|js/|images/).*)",
      "destination": "/api/index"
    }
  ]
}

