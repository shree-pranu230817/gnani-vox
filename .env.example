# ==============================================================================
# UZHAVAR AI – PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and provide your actual private credentials.
# NEVER commit the real '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE API CREDENTIALS
# ------------------------------------------------------------------------------
GNANI_API_KEY=
GEMINI_API_KEY=
DATA_GOV_IN_API_KEY=

# ------------------------------------------------------------------------------
# 1. CORE FLASK APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key for session encryption in production
# (Run in terminal: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=uzhavar-super-secret-key-agri-ai-india-2026

# Environment mode: 'development' or 'production'
FLASK_ENV=development

# Server Port (default: 5000)
PORT=5000

# SQLite Database Location (relative or absolute path)
DATABASE_PATH=uzhavar.db


# ------------------------------------------------------------------------------
# 2. GNANI.AI API CREDENTIALS (PRISMA STT, TIMBRE TTS, EVON MODEL)
# ------------------------------------------------------------------------------
# How to get your Gnani API Key:
# 1. Sign up / login at https://gnani.ai or Vachana platform https://vachana.ai
# 2. Go to API Keys / Dashboard -> Generate Token / API Key.
# 3. Paste the key above at GNANI_API_KEY=

# Official Base URL and endpoints for Gnani Vachana services:
GNANI_BASE_URL=https://api.vachana.ai
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_EVON_ENDPOINT=

# Reasoning Model Configuration (default: uzhavar-agri-reasoner-v1.0)
REASONING_MODEL=uzhavar-agri-reasoner-v1.0
REASONING_MODEL_ENDPOINT=
REASONING_API_KEY=


# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI API CREDENTIALS (REASONING & MULTILINGUAL QA)
# ------------------------------------------------------------------------------
# How to get your Google Gemini API Key:
# 1. Visit Google AI Studio at https://aistudio.google.com/
# 2. Click "Get API Key" -> Create API Key.
# 3. Paste the key above at GEMINI_API_KEY=


# ------------------------------------------------------------------------------
# 4. OFFICIAL GOVERNMENT MANDI API (DATA.GOV.IN / AGMARKNET)
# ------------------------------------------------------------------------------
# How to get your free Government Open Data API Key:
# 1. Visit https://data.gov.in and click "Register" or "Sign In".
# 2. Go to "My Account" -> "API Keys".
# 3. Copy your 40-character API key and paste it above at DATA_GOV_IN_API_KEY=
DATA_GOV_API_KEY=

# Official AGMARKNET daily commodity price API endpoint resource ID:
AGMARKNET_ENDPOINT=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
